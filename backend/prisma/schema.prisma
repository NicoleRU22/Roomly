datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id            Int                 @id @default(autoincrement())
  slug          String              @unique
  companyName   String              @map("company_name")
  createdAt     DateTime            @default(now())

  // Configuración del negocio
  landlordRuc     String?
  landlordAddress String?

  // Reglas de cobro
  lateFeePerDay                  Float  @default(5.0)
  graceDays                      Int    @default(5)
  contractExpirationWarningDays  Int    @default(30)
  defaultBillingDay              Int?   // Día del mes (1-31) usado como día de cobro para contratos sin uno propio configurado

  // Plantilla de recordatorio de WhatsApp (soporta {nombre} como placeholder)
  whatsappTemplate String? @default("Hola {nombre}, te saludamos de Roomly. Te recordamos que tienes cobros pendientes en la plataforma. Por favor ingresa para regularizarlos.")

  // Preferencias de notificaciones al propietario
  notifyComprobantePendiente Boolean @default(true)
  notifyContratoFirmado     Boolean @default(true)
  notifyTicketCreado         Boolean @default(true)

  usuarios      Usuario[]
  properties    Property[]
  rooms         Room[]
  inquilinos    Inquilino[]
  payments      Payment[]
  servicios     Servicio[]
  contratos     Contrato[]
  tickets       MaintenanceTicket[]
  notifications Notification[]
  inquilinoHistorial InquilinoHistorial[]
  mensajes      Mensaje[]
  proveedores   Proveedor[]
}

model Usuario {
  id            Int             @id @default(autoincrement())
  email         String          @unique
  password      String?         // Nulo para cuentas creadas vía Google
  googleId      String?         @unique
  emailVerified Boolean         @default(false)
  verificationToken       String?   @unique
  verificationTokenExpiry DateTime?
  firstName     String
  lastName      String?
  role          String          // "PROPIETARIO", "INQUILINO" o "ADMIN"
  tenantId      Int?            // Nulo para el superadmin de plataforma (rol ADMIN, no pertenece a ningún tenant)
  tenant        Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())
  lastLoginAt   DateTime?       // Se actualiza en cada login exitoso (password o Google)
  notifications Notification[]
  sentMensajes     Mensaje[] @relation("MensajesEnviados")
  receivedMensajes Mensaje[] @relation("MensajesRecibidos")
}

model Property {
  id         Int                 @id @default(autoincrement())
  name       String
  address    String
  price      Float?              // Precio si se arrienda completa
  services   String?             @default("")
  tenantId   Int
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms      Room[]
  inquilinos Inquilino[]
  servicios  Servicio[]
  tickets    MaintenanceTicket[]
}

model Room {
  id         Int                 @id @default(autoincrement())
  roomNumber String
  price      Float
  status     String              // "Disponible", "Ocupado", "Mantenimiento"
  propertyId Int
  property   Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId   Int
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inquilinos Inquilino[]
  payments   Payment[]
  servicios  Servicio[]
  contratos  Contrato[]
  tickets    MaintenanceTicket[]
}

model Inquilino {
  id             Int                 @id @default(autoincrement())
  name           String
  document       String
  email          String
  phone          String?
  status         String              @default("ACTIVO") // "ACTIVO", "INACTIVO", "MOROSO"
  propertyId     Int?
  property       Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  roomId         Int?
  room           Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  moveOutDate    DateTime?           // Fecha de mudanza/salida
  moveOutReason  String?             // Motivo de la salida
  tenantId       Int
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments       Payment[]
  contratos      Contrato[]
  tickets        MaintenanceTicket[]
  historial      InquilinoHistorial[]
}

model InquilinoHistorial {
  id             Int       @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inquilinoId    Int
  inquilino      Inquilino @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
  type           String    // "ALTA", "CAMBIO_HABITACION", "BAJA"
  fromPropertyId Int?
  fromPropertyName String?
  fromRoomId     Int?
  fromRoomNumber String?
  toPropertyId   Int?
  toPropertyName String?
  toRoomId       Int?
  toRoomNumber   String?
  reason         String?
  eventDate      DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@index([inquilinoId])
  @@index([tenantId])
}

model Servicio {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  cost        Float
  tipo        String    // "INCLUIDO" o "ADICIONAL"
  propertyId  Int?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId      Int?
  room        Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Payment {
  id               Int       @id @default(autoincrement())
  inquilinoId      Int       @map("inquilino_id_fk")
  inquilino        Inquilino @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
  roomId           Int?
  room             Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  amount           Float
  amountPaid       Float     @default(0.0)
  delayPenalty     Float     @default(0.0)
  dueDate          DateTime
  lastPaymentDate  DateTime?
  status           String    @default("PENDIENTE") // "PENDIENTE", "PAGADO", "PAGADO_PARCIAL", "VENCIDO", "CANCELADO"
  paymentType      String    @default("ALQUILER") // "ALQUILER", "SERVICIO"
  description      String?
  receiptReference String?
  receiptImageUrl  String?   // URL o ruta local al comprobante subido
  receiptStatus    String    @default("APROBADO") // "PENDIENTE", "APROBADO", "RECHAZADO"
  rejectionReason  String?   // Motivo de rechazo del comprobante
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenantId         Int       @map("tenant_ref_id")
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Contrato {
  id            Int       @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inquilinoId   Int
  inquilino     Inquilino @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
  roomId        Int
  room          Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime
  amount        Float
  diaCobro      Int?      // Día del mes (1-31) en que se genera el cobro. Si es null, se usa el día de startDate.
  status        String    @default("PENDIENTE_FIRMA") // "PENDIENTE_FIRMA", "VIGENTE", "FINALIZADO"
  expirationWarningSent Boolean @default(false) // Evita reenviar el aviso de vencimiento próximo en cada corrida del cron
  landlordName  String?
  landlordRuc   String?
  landlordAddress String?
  specialTerms  String?
  signatureUrl  String?   // URL/Base64/Ruta de la imagen de firma manuscrita
  acceptedTerms Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Proveedor {
  id          Int                 @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  specialty   String              // Ej: "Plomería", "Electricidad", "General"
  phone       String
  notes       String?
  createdAt   DateTime            @default(now())
  tickets     MaintenanceTicket[]
}

model MaintenanceTicket {
  id          Int        @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inquilinoId Int
  inquilino   Inquilino  @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
  propertyId  Int
  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId      Int?
  room        Room?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  proveedorId Int?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  title       String
  description String
  imageUrl    String?    // Foto de la avería
  priority    String     @default("MEDIA") // "ALTA", "MEDIA", "BAJA"
  status      String     @default("PENDIENTE") // "PENDIENTE", "EN_PROGRESO", "RESUELTO"
  comments    String?    // Seguimiento / notas del propietario (Ej: "El plomero irá mañana")
  cost        Float?     // Costo de reparación
  dueDate     DateTime?  // Fecha límite SLA, calculada según la prioridad al crear el ticket
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Mensaje {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  senderId   Int
  sender     Usuario  @relation("MensajesEnviados", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId Int
  receiver   Usuario  @relation("MensajesRecibidos", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([tenantId, senderId, receiverId])
  @@index([receiverId, isRead])
}

model Notification {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    Int
  usuario   Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "PAGO_GENERADO", "PAGO_APROBADO", "PAGO_RECHAZADO", "COMPROBANTE_PENDIENTE", "CONTRATO_PENDIENTE", "CONTRATO_FIRMADO", "TICKET_CREADO", "TICKET_ACTUALIZADO"
  title     String
  message   String
  link      String?  // Ruta relativa del frontend a la que navega, ej. "/pagos"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([tenantId])
}
